prisma:query 
    INSERT INTO "ChatOnline" (phone, room, "lastSeen", name, role)
    VALUES ($1, $2, NOW(), $3, $4)
    ON CONFLICT (phone) DO UPDATE
    SET room = $5, "lastSeen" = NOW(), name = $6, role = $7
  
prisma:query 
      SELECT
        gc.phone,
        gc."firstName",
        gc."lastName",
        gc.hp,
        gc.role,
        CASE
          WHEN co."lastSeen" > NOW() - INTERVAL '2 minutes' AND co.room = 'general'
          THEN true
          ELSE false
        END AS isonline
      FROM "GuestContact" gc
      LEFT JOIN "ChatOnline" co ON co.phone = gc.phone
      ORDER BY isonline DESC, gc.hp DESC
    
