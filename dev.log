prisma:query 
      SELECT
        gc.phone,
        gc."firstName",
        gc."lastName",
        gc.hp,
        gc.role,
        CASE
          WHEN co."lastSeen" > NOW() - INTERVAL '2 minutes' AND co.room = 'general'
          THEN true
          ELSE false
        END AS isonline,
        co."joinedAt" AS joinedat,
        co."leftAt" AS leftat
      FROM "GuestContact" gc
      LEFT JOIN "ChatOnline" co ON co.phone = gc.phone
      ORDER BY isonline DESC, gc.hp DESC
    
