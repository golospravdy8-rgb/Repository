prisma:query 
    INSERT INTO "ChatOnline" (phone, room, "lastSeen", name, role, "joinedAt")
    VALUES ($1, $2, NOW(), $3, $4, COALESCE((SELECT "joinedAt" FROM "ChatOnline" WHERE phone = $5), NOW()))
    ON CONFLICT (phone) DO UPDATE
    SET room = $6, "lastSeen" = NOW(), name = $7, role = $8, "leftAt" = NULL
  
