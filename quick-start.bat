@echo off
setlocal enabledelayedexpansion
chcp 65001 >nul

echo.
echo ╔═══════════════════════════════════════════════════════════════╗
echo ║  🚀 BASKET-LVIV QUICK START v10.0                            ║
echo ║  Быстрый запуск сервера на localhost:3006                   ║
echo ╚═══════════════════════════════════════════════════════════════╝
echo.

cd /d "D:\n8n\basket-lviv"

REM ════════════════════════════════════════════════════════════════
REM 1. УБИВАЕМ ПРОЦЕССЫ
REM ════════════════════════════════════════════════════════════════
echo [1/3] 🔥 Убиваю Node.js процессы...
taskkill /F /IM node.exe 2>nul
timeout /t 2 /nobreak

REM ════════════════════════════════════════════════════════════════
REM 2. ОЧИЩАЕМ ПОРТЫ
REM ════════════════════════════════════════════════════════════════
echo [2/3] 🧹 Очищаю порты 3000-3012...
for /L %%i in (3000,1,3012) do (
    taskkill /FI "localport eq %%i" /T /F 2>nul
)
timeout /t 1 /nobreak

REM ════════════════════════════════════════════════════════════════
REM 3. ЗАПУСКАЕМ СЕРВЕР
REM ════════════════════════════════════════════════════════════════
echo [3/3] 🚀 Запускаю сервер...
echo.
echo ┌─────────────────────────────────────────────────────────────┐
echo │ ✅ Сервер стартует на http://localhost:3006                │
echo │ ⏳ Жди сообщения "Ready in X.Xs"                           │
echo │ 🌐 Потом открой браузер на http://localhost:3006          │
echo └─────────────────────────────────────────────────────────────┘
echo.

call npm run dev:safe

pause
exit /b 0
