generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ShopProduct {
  id           Int      @id @default(autoincrement())
  name         String
  description  String   @default("")
  price        Int
  oldPrice     Int?
  category     String
  emoji        String   @default("🏀")
  badge        String?
  imageUrl     String?
  inStock      Boolean  @default(true)
  sortOrder    Int      @default(0)
  showInChat   Boolean  @default(false)
  chatPriority Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ShopOrder {
  id           Int      @id @default(autoincrement())
  orderNumber  String   @unique
  firstName    String
  lastName     String
  phone        String
  email        String   @default("")
  city         String
  deliveryType String   @default("nova_poshta")
  postOffice   String
  paymentType  String   @default("card")
  items        String
  totalAmount  Int
  status       String   @default("new")
  comment      String   @default("")
  createdAt    DateTime @default(now())
}

model SiteSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
