{
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "app/api/scrape-basket-news/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/api/scrape-basket-news",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=300, stale-while-revalidate=60"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/hp-decay",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/find-live-streams",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sync-tv-matches",
      "schedule": "0 * * * *"
    }
  ]
}
