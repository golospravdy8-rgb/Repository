{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/hp-decay",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/marketplace/:path*",
      "destination": "http://localhost:3007/marketplace/:path*"
    },
    {
      "source": "/courses/:path*",
      "destination": "http://localhost:3008/courses/:path*"
    },
    {
      "source": "/shop/:path*",
      "destination": "http://localhost:3009/shop/:path*"
    },
    {
      "source": "/news-app/:path*",
      "destination": "http://localhost:3010/news-app/:path*"
    }
  ]
}
