# =====================================================
# basket-lviv — Environment Variables Template
# СКОПІЮЙ у .env і заповни реальними значеннями
# .env НІКОЛИ не комітити в git!
# =====================================================

# === DATABASE (Vercel + Neon PostgreSQL) ===
# КРИТИЧНО: Использовать POOLED connection для Vercel (cold starts + timeouts)
# DATABASE_URL: pooler endpoint з connect_timeout=15 для cold start
# PRISMA_DATABASE_URL: direct endpoint для migrations
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&pool_timeout=15"
PRISMA_DATABASE_URL="postgresql://neondb_owner:password@ep-example.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Де взяти:
# 1. Neon Dashboard → Project → Connection string
# 2. Скопіюй pooled connection (default у Neon)
# 3. Додай параметри: &connect_timeout=15&pool_timeout=15
# 4. Для PRISMA_DATABASE_URL використовуй direct connection (без pooler)

# === NEXTAUTH ===
# Генерація: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-min-32-chars"
NEXTAUTH_URL="https://basket-lviv.vercel.app"

# === VERCEL BLOB (для завантаження файлів) ===
# Отримати: vercel.com → Storage → Blob → View Token
# Копіюй токен з Vercel Dashboard
LOGOS_READ_WRITE_TOKEN="vercel_blob_rw_..."

# === GOOGLE OAUTH (опціонально) ===
# Отримати: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
