# ─── База даних ───────────────────────────────────────────────────────────────
#
# SQLite (для локальної розробки — нічого встановлювати не треба):
DATABASE_URL="file:./prisma/dev.db"
#
# PostgreSQL (для production):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/basket_lviv"
# Приклад: "postgresql://postgres:mypassword@localhost:5432/basket_lviv"
# Хмарні варіанти: Supabase, Railway, Neon, PlanetScale


# ─── NextAuth.js ──────────────────────────────────────────────────────────────
#
# ОБОВ'ЯЗКОВО змінити! Згенерувати через: openssl rand -base64 32
NEXTAUTH_SECRET="змініть-на-випадковий-рядок-мінімум-32-символи"
#
# URL сайту (без слешу в кінці)
NEXTAUTH_URL="http://localhost:3000"
# Для production: NEXTAUTH_URL="https://your-domain.com"


# ─── Адміністратор ────────────────────────────────────────────────────────────
#
# Використовується в prisma/seed.ts для створення першого адміна
ADMIN_EMAIL="admin@basket.lviv.ua"
ADMIN_PASSWORD="змініть-на-надійний-пароль"
