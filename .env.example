# =====================================================
# basket-lviv — Environment Variables Template
# СКОПІЮЙ у .env і заповни реальними значеннями
# .env НІКОЛИ не комітити в git!
# =====================================================

# === DATABASE (автоматично з Vercel Marketplace — не чіпати) ===
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=..."
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# === NEXTAUTH ===
# Генерація: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-min-32-chars"
NEXTAUTH_URL="https://basket-lviv.vercel.app"

# === CHAT SERVICE ===
CHAT_URL="http://localhost:3011"
NEXT_PUBLIC_CHAT_URL="http://localhost:3011"

# === GOOGLE OAUTH (опціонально) ===
# Отримати: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"
