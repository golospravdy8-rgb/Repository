  "database_schema_highlights": {
    "Player": {
      "fields": [
        "id (Int, PK)",
        "name (String)",
        "age_category (String)",
        "order (Int)",
        "hp (Int) - NEW: Rucheek HP points",
        "vip_expires_at (DateTime)",
        "stats (BoxScore relation)"
      ],
      "relations": [
        "BoxScore[]",
        "Achievement[]",
        "VipRequest[]"
      ]
    },
    "SiteSettings": {
      "fields": [
        "id (Int, PK)",
        "key (String, @unique)",
        "value (String)",
        "updatedAt (DateTime)"
      ],
      "usage": "Key-value storage for game order counter (game_order_<roomId>)"
    },
    "Game": {
      "fields": [
        "id (Int, PK)",
        "team1_id (Int)",
        "team2_id (Int)",
        "score1 (Int)",
        "score2 (Int)",
        "date (DateTime)",
        "season (String)"
      ]
    }
  },
  "api_endpoints_by_category": {
    "game": [
      "POST /api/pusher/get-order - Get next order (persistent counter in SiteSettings)",
      "POST /api/pusher/reset-order - Reset counter on game restart/exit",
      "POST /api/pusher/join - Broadcast player join",
      "POST /api/pusher/route - Sync player position & ball state",
      "POST /api/pusher/shot - Broadcast shot completion",
      "POST /api/players/add-hp - Award HP to winner"
    ],
    "chat": [
      "GET/POST /api/chat - Chat messages & rooms",
      "POST /api/chat/mvp-vote - MVP voting system",
      "GET /api/chat/leaderboard - Real-time leaderboard",
      "POST /api/chat/messages - Send messages",
      "POST /api/chat/active-poll - Polling system"
    ],
    "admin": [
      "POST /api/admin/login - Admin authentication",
      "POST /api/admin/stats/update - Update player stats",
      "POST /api/admin/standings/reset - Reset standings",
      "POST /api/admin/vip-activate - Activate VIP",
      "GET /api/admin/check - System health check"
    ],
    "shop": [
      "GET /api/shop/products - Product listing",
      "POST /api/shop/orders - Process orders",
      "GET /api/shop/products-chat - Products for chat shop"
    ],
    "media": [
      "POST /api/blob/upload - Vercel Blob upload",
      "POST /api/gallery/upload-token - Gallery image upload",
      "GET /api/videos - Video listings"
    ],
    "integration": [
      "GET /api/tv-matches - TV match schedule",
      "GET /api/nba-schedule - NBA schedule",
      "GET /api/news - News feed",
      "GET /api/standings - League standings"
    ]
  },
  "pusher_events": {
