generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl: використовується для migrations, не потрібен на Vercel
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

model Season {
  id        Int        @id @default(autoincrement())
  name      String
  isActive  Boolean    @default(true)
  ageGroup  String     @default("younger")
  games     Game[]
  standings Standing[]
  teams     Team[]
}

model Team {
  id        Int        @id @default(autoincrement())
  name      String
  shortName String
  logoUrl   String?
  seasonId  Int
  ageGroup  String     @default("younger")
  boxScores BoxScore[]
  awayGames Game[]     @relation("AwayTeam")
  homeGames Game[]     @relation("HomeTeam")
  players   Player[]
  standing  Standing?
  season    Season     @relation(fields: [seasonId], references: [id])
}

model Player {
  id              Int                 @id @default(autoincrement())
  number          Int
  firstName       String
  lastName        String
  position        String?
  teamId          Int
  photoUrl        String?
  boxScores       BoxScore[]
  gameEvents      GameEvent[]
  team            Team                @relation(fields: [teamId], references: [id])
  achievements    PlayerAchievement[]
}

model Game {
  id          Int         @id @default(autoincrement())
  seasonId    Int
  homeTeamId  Int
  awayTeamId  Int
  scheduledAt DateTime
  status      String      @default("SCHEDULED")
  quarter     Int         @default(1)
  homeScore   Int         @default(0)
  awayScore   Int         @default(0)
  boxScores   BoxScore[]
  awayTeam    Team        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam    Team        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  season      Season      @relation(fields: [seasonId], references: [id])
  events      GameEvent[]
}

model GameEvent {
  id        Int      @id @default(autoincrement())
  gameId    Int
  playerId  Int?
  teamId    Int
  type      String
  points    Int?
  quarter   Int
  createdAt DateTime @default(now())
  game      Game     @relation(fields: [gameId], references: [id])
  player    Player?  @relation(fields: [playerId], references: [id])
}

model BoxScore {
  id          Int     @id @default(autoincrement())
  gameId      Int
  playerId    Int
  teamId      Int
  points      Int     @default(0)
  rebounds    Int     @default(0)
  assists     Int     @default(0)
  steals      Int     @default(0)
  blocks      Int     @default(0)
  fouls       Int     @default(0)
  minutes     Int     @default(0)
  isStarter   Boolean @default(false)
  missedFg2   Int     @default(0)
  missedFg3   Int     @default(0)
  missedFt    Int     @default(0)
  reboundsDef Int     @default(0)
  reboundsOff Int     @default(0)
  turnovers   Int     @default(0)
  game        Game    @relation(fields: [gameId], references: [id])
  player      Player  @relation(fields: [playerId], references: [id])
  team        Team    @relation(fields: [teamId], references: [id])
}

model Standing {
  id            Int    @id @default(autoincrement())
  teamId        Int    @unique
  seasonId      Int
  wins          Int    @default(0)
  losses        Int    @default(0)
  pointsFor     Int    @default(0)
  pointsAgainst Int    @default(0)
  gamesPlayed   Int    @default(0)
  rank          Int?
  season        Season @relation(fields: [seasonId], references: [id])
  team          Team   @relation(fields: [teamId], references: [id])
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  category    String?
}

model AdminUser {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String
}

model SiteSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  thumbnail   String?
  type        String   @default("highlights")
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
}

model Review {
  id        Int      @id @default(autoincrement())
  author    String
  text      String
  createdAt DateTime @default(now())
}

model GuestContact {
  id             Int      @id @default(autoincrement())
  phone          String   @unique
  firstName      String
  lastName       String
  refCode        String?
  hp             Int      @default(25)
  isLeaguePlayer Boolean  @default(false)
  createdAt      DateTime @default(now())
  avatarInitials String?
  childTeamId    Int?
  displayName    String?
  role           String   @default("guest")
}

model MvpVote {
  id         Int      @id @default(autoincrement())
  voterPhone String
  playerName String
  createdAt  DateTime @default(now())
  gameId     Int?
  playerId   Int?

  @@unique([gameId, voterPhone])
  @@index([gameId])
}

model ChatMessage {
  id        Int            @id @default(autoincrement())
  phone     String
  name      String
  text      String
  replyToId Int?
  createdAt DateTime       @default(now())
  roomId    String         @default("general")
  replyTo   ChatMessage?   @relation("Replies", fields: [replyToId], references: [id])
  replies   ChatMessage[]  @relation("Replies")
  reactions ChatReaction[]

  @@index([roomId])
}

model ChatReaction {
  id        Int         @id @default(autoincrement())
  messageId Int
  phone     String
  emoji     String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, phone, emoji])
}

model ChatModerator {
  id         Int      @id @default(autoincrement())
  phone      String   @unique
  name       String   @default("")
  assignedBy String   @default("")
  addedAt    DateTime @default(now())
}

model ChatRoom {
  id        String   @id @default("general")
  slowMode  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model ChatBan {
  id          Int       @id @default(autoincrement())
  phone       String    @unique
  reason      String    @default("")
  bannedUntil DateTime?
  createdAt   DateTime  @default(now())
}

model ChatMute {
  id         Int      @id @default(autoincrement())
  phone      String   @unique
  mutedUntil DateTime
  createdAt  DateTime @default(now())
}

model ChatWarn {
  id        Int      @id @default(autoincrement())
  phone     String
  reason    String   @default("")
  createdAt DateTime @default(now())
}

model ChatPinnedMessage {
  id        Int      @id @default(autoincrement())
  text      String
  updatedAt DateTime @updatedAt
}

model ChatMvpVote {
  id         Int      @id @default(autoincrement())
  voterPhone String
  playerName String
  month      String
  createdAt  DateTime @default(now())

  @@unique([voterPhone, month])
}

model ChatDailyFirstMsg {
  id        Int      @id @default(autoincrement())
  phone     String
  day       String
  createdAt DateTime @default(now())

  @@unique([phone, day])
}

model ChatDailySpin {
  id        Int      @id @default(autoincrement())
  phone     String
  day       String
  hpGained  Int
  createdAt DateTime @default(now())

  @@unique([phone, day])
}

model ChatStreak {
  id            Int      @id @default(autoincrement())
  phone         String   @unique
  currentStreak Int      @default(0)
  lastVisit     String   @default("")
  updatedAt     DateTime @updatedAt
}

model ChatOnline {
  phone    String   @id
  room     String   @default("general")
  lastSeen DateTime @default(now())
  name     String?
  role     String   @default("player")

  @@index([room])
  @@index([lastSeen])
}

model ChatPoll {
  id        Int          @id @default(autoincrement())
  question  String
  options   String[]
  createdBy String
  createdAt DateTime     @default(now())
  isActive  Boolean      @default(true)
  votes     ChatPollVote[]
}

model ChatPollVote {
  id        Int       @id @default(autoincrement())
  pollId    Int
  voterPhone String
  optionIdx Int
  createdAt DateTime  @default(now())
  poll      ChatPoll  @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterPhone])
  @@index([pollId])
}

model PlayerAchievement {
  id         Int      @id @default(autoincrement())
  playerId   Int
  badgeId    String
  unlockedAt DateTime @default(now())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, badgeId])
}

model MediaLike {
  id        Int      @id @default(autoincrement())
  phone     String
  mediaType String
  mediaKey  String
  createdAt DateTime @default(now())

  @@unique([phone, mediaType, mediaKey])
}

model ChatGameAttendance {
  id        Int      @id @default(autoincrement())
  gameId    Int
  phone     String
  name      String
  createdAt DateTime @default(now())

  @@unique([gameId, phone])
}

model ShopOrder {
  id           Int      @id @default(autoincrement())
  orderNumber  String   @unique
  firstName    String
  lastName     String
  phone        String
  email        String   @default("")
  city         String
  deliveryType String   @default("nova_poshta")
  postOffice   String
  paymentType  String   @default("card")
  items        String
  totalAmount  Int
  status       String   @default("new")
  comment      String   @default("")
  createdAt    DateTime @default(now())
}

model ShopProduct {
  id           Int      @id @default(autoincrement())
  name         String
  description  String   @default("")
  price        Int
  oldPrice     Int?
  category     String
  emoji        String   @default("🏀")
  badge        String?
  imageUrl     String?
  sizes        String?
  inStock      Boolean  @default(true)
  sortOrder    Int      @default(0)
  showInChat   Boolean  @default(true)
  chatPriority Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PlaygroundCheckin {
  id        Int       @id @default(autoincrement())
  phone     String    @unique
  name      String
  status    String    // "їду" | "їду_20" | "потрібен_1"
  checkinAt DateTime  @default(now())
  resetAt   DateTime?
}

model MarketplaceListing {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  price       Int
  category    String
  condition   String
  seller      String
  phone       String
  imageUrl    String?
  emoji       String   @default("🏀")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AuctionItem {
  id          Int          @id @default(autoincrement())
  title       String
  description String       @default("")
  category    String
  seller      String
  phone       String
  imageUrl    String?
  emoji       String       @default("🏀")
  startPrice  Int
  currentBid  Int
  minStep     Int          @default(50)
  endsAt      DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  bids        AuctionBid[]
}

model AuctionBid {
  id        Int         @id @default(autoincrement())
  amount    Int
  bidder    String
  phone     String      @default("")
  auctionId Int
  createdAt DateTime    @default(now())
  auction   AuctionItem @relation(fields: [auctionId], references: [id])
}

model ChatModAction {
  id          Int      @id @default(autoincrement())
  action      String
  modPhone    String
  modName     String   @default("")
  targetPhone String   @default("")
  targetName  String   @default("")
  details     String   @default("")
  createdAt   DateTime @default(now())
}

model MatchPrediction {
  id           Int      @id @default(autoincrement())
  gameId       Int
  phone        String
  name         String   @default("")
  role         String   @default("parent")
  homeScore    Int
  awayScore    Int
  isCorrect    Boolean?
  pointsEarned Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([gameId, phone])
  @@index([gameId])
}

model GameRsvp {
  id          Int      @id @default(autoincrement())
  gameId      Int
  phone       String
  name        String   @default("")
  role        String   @default("parent")
  childTeamId Int?
  createdAt   DateTime @default(now())

  @@unique([gameId, phone])
  @@index([gameId])
}

model ParentSession {
  id          Int      @id @default(autoincrement())
  phone       String
  token       String   @unique
  name        String   @default("")
  childTeamId Int?
  createdAt   DateTime @default(now())
  expiresAt   DateTime @default(dbgenerated("(now() + '30 days'::interval)"))

  @@index([token])
}
