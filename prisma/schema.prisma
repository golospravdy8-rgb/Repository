generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Season {
  id        Int        @id @default(autoincrement())
  name      String
  isActive  Boolean    @default(true)
  ageGroup  String     @default("younger")
  games     Game[]
  standings Standing[]
  teams     Team[]
}

model Team {
  id             Int                   @id @default(autoincrement())
  name           String
  shortName      String
  logoUrl        String?
  seasonId       Int
  ageGroup       String                @default("younger")
  coachName      String?
  assistantCoach String?
  boxScores      BoxScore[]
  awayGames      Game[]                @relation("AwayTeam")
  homeGames      Game[]                @relation("HomeTeam")
  players        Player[]
  substitutions  GameSubstitution[]
  onCourt        GameOnCourt[]
  standing       Standing?
  groupTeams     GroupTeam[]
  season         Season                @relation(fields: [seasonId], references: [id])
}

model Player {
  id               Int                   @id @default(autoincrement())
  number           Int
  firstName        String
  lastName         String
  position         String?
  teamId           Int
  photoUrl         String?
  hp               Int                   @default(0)  // 🏀 RUCHEEK: Health points from game wins
  boxScores        BoxScore[]
  gameEvents       GameEvent[]
  substitutions    GameSubstitution[]
  onCourt          GameOnCourt[]
  team             Team                  @relation(fields: [teamId], references: [id])
  achievements     PlayerAchievement[]
}

model Tour {
  id       Int    @id @default(autoincrement())
  name     String
  order    Int    @default(0)
  ageGroup String
  games    Game[]

  @@unique([ageGroup, order])
  @@index([ageGroup])
}

model Group {
  id         Int         @id @default(autoincrement())
  name       String
  ageGroup   String
  groupTeams GroupTeam[]

  @@index([ageGroup])
}

model GroupTeam {
  id      Int   @id @default(autoincrement())
  groupId Int
  teamId  Int
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team    Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamId])
}

model Game {
  id                    Int                   @id @default(autoincrement())
  seasonId              Int
  homeTeamId            Int
  awayTeamId            Int
  tourId                Int?
  scheduledAt           DateTime
  status                String                @default("SCHEDULED")
  quarter               Int                   @default(1)
  homeScore             Int                   @default(0)
  awayScore             Int                   @default(0)

  // Home team advanced stats
  ptsOffTurnovers       Int                   @default(0)
  ptsFastBreak          Int                   @default(0)
  ptsSecondChance       Int                   @default(0)
  ptsAfterSubstitutions Int                   @default(0)
  biggestLead           Int                   @default(0)
  biggestRun            Int                   @default(0)

  // Away team advanced stats
  awayPtsOffTurnovers   Int                   @default(0)
  awayPtsFastBreak      Int                   @default(0)
  awayPtsSecondChance   Int                   @default(0)
  awayPtsAfterSubstitutions Int                @default(0)
  awayBiggestLead       Int                   @default(0)
  awayBiggestRun        Int                   @default(0)

  // FIBA protocol fields (old, for backward compat)
  commissioner          String?
  referee1              String?
  referee2              String?
  referee3              String?
  venue                 String?
  round                 String?

  // FIBA protocol fields (new)
  referee               String?
  umpire1               String?
  umpire2               String?
  scorer                String?
  assistantScorer       String?
  timer                 String?
  shotClockOperator     String?
  gameNumber            String?
  protest               Boolean               @default(false)
  protestNote           String?

  // Play-off fields
  stage                 String?               // 'group' | 'semifinal' | 'final' | 'third_place'
  sourceA               String?               // "A1", "B2", "Winner SF1"
  sourceB               String?               // "B1", "A2", "Winner SF2"

  // Play-off match details (for editing in admin panel)
  playoffTeamA          String?               // Team A name
  playoffTeamB          String?               // Team B name
  playoffScoreA         Int?                  // Team A score
  playoffScoreB         Int?                  // Team B score

  // Timeouts
  homeTimeouts          Int                   @default(0)
  awayTimeouts          Int                   @default(0)

  boxScores             BoxScore[]
  awayTeam              Team                  @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeTeam              Team                  @relation("HomeTeam", fields: [homeTeamId], references: [id])
  season                Season                @relation(fields: [seasonId], references: [id])
  tour                  Tour?                 @relation(fields: [tourId], references: [id], onDelete: SetNull)
  events                GameEvent[]
  substitutions         GameSubstitution[]
  onCourt               GameOnCourt[]
  protocolOverrides     ProtocolOverride[]
  protocolAuditLogs     ProtocolAuditLog[]
}

model GameEvent {
  id            Int      @id @default(autoincrement())
  gameId        Int
  playerId      Int?
  teamId        Int
  type          String
  points        Int?
  quarter       Int
  eventSubtype  String?  // 'normal', 'fastbreak', 'second_chance', 'off_turnover'
  createdAt     DateTime @default(now())
  game          Game     @relation(fields: [gameId], references: [id])
  player        Player?  @relation(fields: [playerId], references: [id])
}

model GameSubstitution {
  id         Int      @id @default(autoincrement())
  gameId     Int
  playerId   Int
  teamId     Int
  action     String   // 'in' or 'out'
  quarter    Int?
  gameTime   String?  // e.g., "5:23"
  createdAt  DateTime @default(now())
  game       Game     @relation(fields: [gameId], references: [id])
  player     Player   @relation(fields: [playerId], references: [id])
  team       Team     @relation(fields: [teamId], references: [id])
}

model GameOnCourt {
  gameId   Int
  playerId Int
  teamId   Int
  onCourt  Boolean  @default(false)
  game     Game     @relation(fields: [gameId], references: [id])
  player   Player   @relation(fields: [playerId], references: [id])
  team     Team     @relation(fields: [teamId], references: [id])

  @@id([gameId, playerId])
}

model BoxScore {
  id               Int     @id @default(autoincrement())
  gameId           Int
  playerId         Int
  teamId           Int
  points           Int     @default(0)
  rebounds         Int     @default(0)
  assists          Int     @default(0)
  steals           Int     @default(0)
  blocks           Int     @default(0)
  fouls            Int     @default(0)
  minutes          Int     @default(0)
  minutesPlayed    String? // Format: "MM:SS"
  isStarter        Boolean @default(false)
  fgMade           Int     @default(0)
  fgAttempted      Int     @default(0)
  fg2Made          Int     @default(0)
  fg2Attempted     Int     @default(0)
  fg3Made          Int     @default(0)
  fg3Attempted     Int     @default(0)
  ftMade           Int     @default(0)
  ftAttempted      Int     @default(0)
  missedFg2        Int     @default(0)
  missedFg3        Int     @default(0)
  missedFt         Int     @default(0)
  reboundsDef      Int     @default(0)
  reboundsOff      Int     @default(0)
  turnovers        Int     @default(0)
  plusMinus        Int     @default(0)
  efficiency       Float   @default(0.0)
  game             Game    @relation(fields: [gameId], references: [id])
  player           Player  @relation(fields: [playerId], references: [id])
  team             Team    @relation(fields: [teamId], references: [id])
}

model Standing {
  id            Int    @id @default(autoincrement())
  teamId        Int    @unique
  seasonId      Int
  wins          Int    @default(0)
  losses        Int    @default(0)
  pointsFor     Int    @default(0)
  pointsAgainst Int    @default(0)
  gamesPlayed   Int    @default(0)
  rank          Int?
  season        Season @relation(fields: [seasonId], references: [id])
  team          Team   @relation(fields: [teamId], references: [id])
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  content     String
  imageUrl    String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  category    String?
}

model AdminUser {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
  name     String
  hp       Int     @default(0)
  hpLogs   HpLog[]
}

model HpLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  points    Int
  reason    String
  createdAt DateTime @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SiteSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Video {
  id          Int      @id @default(autoincrement())
  title       String
  url         String
  thumbnail   String?
  type        String   @default("highlights")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  isPublished Boolean  @default(true)
}

model Review {
  id        Int      @id @default(autoincrement())
  author    String
  text      String
  createdAt DateTime @default(now())
}

model GuestContact {
  id             Int      @id @default(autoincrement())
  phone          String   @unique
  firstName      String
  lastName       String
  refCode        String?
  hp             Int      @default(25)
  isLeaguePlayer Boolean  @default(false)
  createdAt      DateTime @default(now())
  avatarInitials String?
  childTeamId    Int?
  displayName    String?
  role           String   @default("guest")
}

model MvpVote {
  id         Int      @id @default(autoincrement())
  voterPhone String
  playerName String
  createdAt  DateTime @default(now())
  gameId     Int?
  playerId   Int?

  @@unique([gameId, voterPhone])
  @@index([gameId])
}

model ChatMessage {
  id        Int            @id @default(autoincrement())
  phone     String
  name      String
  text      String
  replyToId Int?
  createdAt DateTime       @default(now())
  roomId    String         @default("general")
  replyTo   ChatMessage?   @relation("Replies", fields: [replyToId], references: [id])
  replies   ChatMessage[]  @relation("Replies")
  reactions ChatReaction[]

  @@index([roomId])
}

model ChatReaction {
  id        Int         @id @default(autoincrement())
  messageId Int
  phone     String
  emoji     String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, phone, emoji])
}

model ChatModerator {
  id         Int      @id @default(autoincrement())
  phone      String   @unique
  name       String   @default("")
  assignedBy String   @default("")
  addedAt    DateTime @default(now())
}

model ChatRoom {
  id        String   @id @default("general")
  slowMode  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model ChatBan {
  id          Int       @id @default(autoincrement())
  phone       String    @unique
  reason      String    @default("")
  bannedUntil DateTime?
  createdAt   DateTime  @default(now())
}

model TvMatch {
  id        String    @id @default(cuid())
  title     String
  url       String    @unique
  matchDate DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@index([matchDate])
}

model NbaSchedule {
  id           String    @id @default(cuid())
  gameId       String    @unique
  homeTeam     String
  awayTeam     String
  gameTime     DateTime
  kyivTime     DateTime  // Київський час (UTC+3)
  status       String    @default("scheduled") // scheduled, live, finished
  season       Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([gameTime])
  @@index([status])
}

model LiveSession {
  id            String    @id @default(cuid())
  gameId        String    @unique
  homeTeam      String
  awayTeam      String
  gameTime      DateTime
  kyivTime      DateTime
  liveUrl       String?   // Робоче посилання на трансляцію
  liveSource    String?   // ok.ru, dailymotion, youtube, tbd
  isActive      Boolean   @default(false)
  lastChecked   DateTime  @default(now())
  checkCount    Int       @default(0)

  // 10-minute search window tracking
  firstSearchAt   DateTime?  // Timestamp of first search attempt (at game start)
  secondSearchAt  DateTime?  // Timestamp of second search attempt (at +10 min)
  searchCompleted Boolean    @default(false)  // ⭐ true = no more searches for this game

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([gameTime])
  @@index([isActive])
  @@index([searchCompleted])
}

model UserStream {
  id          String    @id @default(cuid())
  gameId      String    // NBA game ID
  gameTitle   String    // "Lakers vs Knicks"
  gameTime    DateTime  // Game start time
  kyivTime    DateTime  // Time in Kyiv timezone

  streamUrl   String    // The live stream link
  submittedBy String    // Username or anonymous

  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([gameId])
  @@index([gameTime])
  @@index([isActive])
}

model ChatMute {
  id         Int      @id @default(autoincrement())
  phone      String   @unique
  mutedUntil DateTime
  createdAt  DateTime @default(now())
}

model ChatWarn {
  id        Int      @id @default(autoincrement())
  phone     String
  reason    String   @default("")
  createdAt DateTime @default(now())
}

model ChatPinnedMessage {
  id        Int      @id @default(autoincrement())
  text      String
  updatedAt DateTime @updatedAt
}

model ChatMvpVote {
  id         Int      @id @default(autoincrement())
  voterPhone String
  playerName String
  month      String
  createdAt  DateTime @default(now())

  @@unique([voterPhone, month])
}

model ChatDailyFirstMsg {
  id        Int      @id @default(autoincrement())
  phone     String
  day       String
  createdAt DateTime @default(now())

  @@unique([phone, day])
}

model ChatDailySpin {
  id        Int      @id @default(autoincrement())
  phone     String
  day       String
  hpGained  Int
  createdAt DateTime @default(now())

  @@unique([phone, day])
}

model ChatStreak {
  id            Int      @id @default(autoincrement())
  phone         String   @unique
  currentStreak Int      @default(0)
  lastVisit     String   @default("")
  updatedAt     DateTime @updatedAt
}

model TvSession {
  id            Int       @id @default(autoincrement())
  match_id      String?
  match_title   String
  match_url     String
  started_by    String
  started_at    DateTime  @default(now())
  video_started_at DateTime?
  current_time_sec Float   @default(0)
  time_updated_at  DateTime?
  viewers       TvViewer[]

  @@map("tv_session")
}

model TvViewer {
  id          Int       @id @default(autoincrement())
  session_id  Int
  user_name   String
  session     TvSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("tv_viewers")
}

model ChatOnline {
  phone    String   @id
  room     String   @default("general")
  lastSeen DateTime @default(now())
  name     String?
  role     String   @default("player")
  joinedAt DateTime @default(now())
  leftAt   DateTime?

  @@index([room])
  @@index([lastSeen])
}

model ChatPoll {
  id        Int          @id @default(autoincrement())
  question  String
  options   String[]
  createdBy String
  createdAt DateTime     @default(now())
  isActive  Boolean      @default(true)
  votes     ChatPollVote[]
}

model ChatPollVote {
  id        Int       @id @default(autoincrement())
  pollId    Int
  voterPhone String
  optionIdx Int
  createdAt DateTime  @default(now())
  poll      ChatPoll  @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, voterPhone])
  @@index([pollId])
}

model PlayerAchievement {
  id         Int      @id @default(autoincrement())
  playerId   Int
  badgeId    String
  unlockedAt DateTime @default(now())
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, badgeId])
}

model MediaLike {
  id        Int      @id @default(autoincrement())
  phone     String
  mediaType String
  mediaKey  String
  createdAt DateTime @default(now())

  @@unique([phone, mediaType, mediaKey])
}

model ChatGameAttendance {
  id        Int      @id @default(autoincrement())
  gameId    Int
  phone     String
  name      String
  createdAt DateTime @default(now())

  @@unique([gameId, phone])
}

model ShopOrder {
  id           Int      @id @default(autoincrement())
  orderNumber  String   @unique
  firstName    String
  lastName     String
  phone        String
  email        String   @default("")
  city         String
  deliveryType String   @default("nova_poshta")
  postOffice   String
  paymentType  String   @default("card")
  items        String
  totalAmount  Int
  status       String   @default("new")
  comment      String   @default("")
  createdAt    DateTime @default(now())
}

model ShopProduct {
  id           Int      @id @default(autoincrement())
  name         String
  description  String   @default("")
  price        Int
  oldPrice     Int?
  category     String
  emoji        String   @default("🏀")
  badge        String?
  imageUrl     String?
  sizes        String?
  inStock      Boolean  @default(true)
  sortOrder    Int      @default(0)
  showInChat   Boolean  @default(true)
  chatPriority Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PlaygroundCheckin {
  id        Int       @id @default(autoincrement())
  phone     String    @unique
  name      String
  status    String    // "їду" | "їду_20" | "потрібен_1"
  checkinAt DateTime  @default(now())
  resetAt   DateTime?
}

model MarketplaceListing {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  price       Int
  category    String
  condition   String
  seller      String
  phone       String
  imageUrl    String?
  emoji       String   @default("🏀")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AuctionItem {
  id          Int          @id @default(autoincrement())
  title       String
  description String       @default("")
  category    String
  seller      String
  phone       String
  imageUrl    String?
  emoji       String       @default("🏀")
  startPrice  Int
  currentBid  Int
  minStep     Int          @default(50)
  endsAt      DateTime
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  bids        AuctionBid[]
}

model AuctionBid {
  id        Int         @id @default(autoincrement())
  amount    Int
  bidder    String
  phone     String      @default("")
  auctionId Int
  createdAt DateTime    @default(now())
  auction   AuctionItem @relation(fields: [auctionId], references: [id])
}

model ChatModAction {
  id          Int      @id @default(autoincrement())
  action      String
  modPhone    String
  modName     String   @default("")
  targetPhone String   @default("")
  targetName  String   @default("")
  details     String   @default("")
  createdAt   DateTime @default(now())
}

model MatchPrediction {
  id           Int      @id @default(autoincrement())
  gameId       Int
  phone        String
  name         String   @default("")
  role         String   @default("parent")
  homeScore    Int
  awayScore    Int
  isCorrect    Boolean?
  pointsEarned Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([gameId, phone])
  @@index([gameId])
}

model GameRsvp {
  id          Int      @id @default(autoincrement())
  gameId      Int
  phone       String
  name        String   @default("")
  role        String   @default("parent")
  childTeamId Int?
  createdAt   DateTime @default(now())

  @@unique([gameId, phone])
  @@index([gameId])
}

model ParentSession {
  id          Int      @id @default(autoincrement())
  phone       String
  token       String   @unique
  name        String   @default("")
  childTeamId Int?
  createdAt   DateTime @default(now())
  expiresAt   DateTime @default(dbgenerated("(now() + '30 days'::interval)"))

  @@index([token])
}

model ProtocolOverride {
  id        Int      @id @default(autoincrement())
  gameId    Int
  fieldPath String
  oldValue  String?
  newValue  String?
  reason    String   @default("")
  createdAt DateTime @default(now())
  createdBy String   @default("admin")
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model ProtocolAuditLog {
  id        Int      @id @default(autoincrement())
  gameId    Int
  action    String
  details   String   @default("")
  createdAt DateTime @default(now())
  createdBy String   @default("admin")
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

// Плей-офф (независимо от Game)
model Playoff {
  id                String   @id @default(cuid())
  ageGroup          String   // "younger" | "older" | "u16"

  // ПОЛУФИНАЛ 1
  semifinal1TeamA   String?
  semifinal1TeamB   String?
  semifinal1ScoreA  Int?
  semifinal1ScoreB  Int?

  // ПОЛУФИНАЛ 2
  semifinal2TeamA   String?
  semifinal2TeamB   String?
  semifinal2ScoreA  Int?
  semifinal2ScoreB  Int?

  // ФИНАЛ
  finalTeamA        String?
  finalTeamB        String?
  finalScoreA       Int?
  finalScoreB       Int?

  // ЗА 3 МІСЦЕ
  thirdPlaceTeamA   String?
  thirdPlaceTeamB   String?
  thirdPlaceScoreA  Int?
  thirdPlaceScoreB  Int?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([ageGroup])  // Одна запись на ageGroup
}

// Таблицы соревнований (независимо от Game и Playoff)
model GroupTables {
  id        String   @id @default(cuid())
  ageGroup  String   // "younger" | "older" | "u16"
  groupA    String[] // JSON array of team names
  groupB    String[] // JSON array of team names
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ageGroup])  // Одна запись на ageGroup
}

